{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.qomicex.top/:path*",
      "permanent": true,
      "has": [{ "type": "host", "value": "qomicex.top" }]
    },
    {
      "source": "/docs/:path*/",
      "destination": "https://docs.qomicex.top/",
      "permanent": true
    },
    {
      "source": "/en/docs/:path*/",
      "destination": "https://docs.qomicex.top/",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.qomicex.top/",
      "permanent": true
    },
    {
      "source": "/en/docs/:path*",
      "destination": "https://docs.qomicex.top/",
      "permanent": true
    },
    {
      "source": "/tutorial/:path*/",
      "destination": "https://docs.qomicex.top/",
      "permanent": true
    },
    {
      "source": "/tutorial/:path*",
      "destination": "https://docs.qomicex.top/",
      "permanent": true
    }
  ]
}

---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs
    .filter(d => d.id.startsWith('zh/'))
    .map(d => ({ params: { slug: d.id.split('/').slice(1).join('/') } }))
}
---

<Base title="文档">
  <meta http-equiv="refresh" content="0;url=https://docs.qomicex.top" />
  <div class="mx-auto max-w-lg px-4 py-20 text-center">
    <p class="text-muted-foreground">文档已迁移至 <a href="https://docs.qomicex.top" class="text-primary underline underline-offset-2">docs.qomicex.top</a>。</p>
  </div>
</Base>

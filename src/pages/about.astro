---
import Base from '../layouts/Base.astro';
import releases from '../data/releases.json';
import contributors from '../data/contributors.json';
import AppInfoCard from '../components/about/AppInfoCard';
import ContributorCard from '../components/about/ContributorCard';
import FriendsCard from '../components/about/FriendsCard';
import { friends } from '../data/friends.ts';
import { t, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname)
const latestStable = releases.find(r => !r.prerelease)
const latestPre = releases.find(r => r.prerelease)
---

<Base title="关于" page="about">
  <section data-animate class="mx-auto max-w-3xl px-4 py-16">

    {/* App Info — 岛屿化 */}
    <AppInfoCard
      logoSrc="/logo.svg"
      logoAlt="Qomicex Launcher"
      name="Qomicex Launcher"
      versionLabel="版本"
      version={latestPre ? `${latestPre.version}${latestPre.prerelease ? ' (测试版)' : ''}` : latestStable?.version ?? '...' }
      description="一个现代化的 Minecraft 启动器，拥有完善的多实例管理、快捷的模组安装、账户管理、多人联机、个性化主题设置等功能。完全开源，使用 GPL-3.0 许可协议。"
      repoUrl="https://github.com/Qomicex-Public/Qomicex.Tauri"
      repoLabel="查看仓库"
    />

    {/* Version Info — 原样保留（非卡片 UI，数据展示块） */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">版本信息</h2>
      <div class="rounded-lg bg-background p-4 text-sm">
        <div class="grid grid-cols-2 gap-3">
          {latestStable && <div><div class="text-xs text-muted-foreground">正式版</div><div class="mt-0.5 font-medium">{latestStable.version}</div></div>}
          {latestPre && <div><div class="text-xs text-muted-foreground">测试版</div><div class="mt-0.5 font-medium">{latestPre.version}</div></div>}
          {!latestStable && !latestPre && <div><div class="text-xs text-muted-foreground">应用版本</div><div class="mt-0.5 font-medium">...</div></div>}
          <div><div class="text-xs text-muted-foreground">许可协议</div><div class="mt-0.5 font-medium"><a href="https://www.gnu.org/licenses/gpl-3.0.en.html" target="_blank" class="text-primary underline underline-offset-2">GPL-3.0</a></div></div>
        </div>
      </div>
    </div>

    {/* Contributors — 岛屿化 */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">开发者</h2>
      {contributors.length === 0 && <p class="text-sm text-muted-foreground">暂无贡献者信息。</p>}
      <div class="space-y-3">
        {contributors.map(c => (
          <ContributorCard
            avatarUrl={c.avatar_url}
            login={c.login}
            contributions={c.contributions}
            htmlUrl={c.html_url}
          />
        ))}
      </div>
    </div>

    {/* 友情链接 — 友链伙伴（MCNav 要求提交收录前先挂其友链） */}
    <FriendsCard
      title={t('about.friends', lang)}
      items={friends.map(f => ({ name: f.name, url: f.url, desc: f.desc[lang] }))}
    />

  </section>
</Base>

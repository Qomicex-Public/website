---
import Base from '../layouts/Base.astro';
import releases from '../data/releases.json';
import ReleaseEntry from '../components/changelog/ReleaseEntry';
---

<Base title="更新日志">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="mb-8 text-3xl font-bold">更新日志</h1>
    {releases.length === 0 && <p class="text-muted-foreground">暂无更新记录。</p>}
    <div class="space-y-4">
      {releases.map(r => (
        <div class="rounded-xl border border-border bg-card p-5">
          <ReleaseEntry
            version={r.version}
            date={r.publishedAt.slice(0, 7)}
            isPrerelease={!!r.prerelease}
            prereleaseLabel="测试版"
            changes={r.changes}
            changesLabel="无详细更新说明"
            detailLabel="GitHub 发布页"
            detailUrl={r.htmlUrl}
          />
        </div>
      ))}
    </div>
  </section>
</Base>

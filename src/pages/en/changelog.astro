---
import Base from '../../layouts/Base.astro';
import releases from '../../data/releases.json';
import ReleaseEntry from '../../components/changelog/ReleaseEntry';
---

<Base title="Changelog" page="changelog">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="mb-8 text-3xl font-bold">Changelog</h1>
    {releases.length === 0 && <p class="text-muted-foreground">No changelog records.</p>}
    <div class="space-y-4">
      {releases.map(r => (
        <div class="rounded-xl border border-border bg-card p-5">
          <ReleaseEntry
            version={r.version}
            date={r.publishedAt.slice(0, 7)}
            isPrerelease={!!r.prerelease}
            prereleaseLabel="Preview"
            changes={r.changes}
            changesLabel="No detailed changelog."
            detailLabel="GitHub Release"
            detailUrl={r.htmlUrl}
          />
        </div>
      ))}
    </div>
  </section>
</Base>

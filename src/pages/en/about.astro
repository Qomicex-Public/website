---
import Base from '../../layouts/Base.astro';
import releases from '../../data/releases.json';
import contributors from '../../data/contributors.json';
import { platforms } from '../../data/platforms.ts';
import AppInfoCard from '../../components/about/AppInfoCard';
import ContributorCard from '../../components/about/ContributorCard';
import FriendsCard from '../../components/about/FriendsCard';
import { friends } from '../../data/friends.ts';
import { t, langFromPath } from '../../i18n';

const lang = langFromPath(Astro.url.pathname)
const latestStable = releases.find(r => !r.prerelease)
const latestPre = releases.find(r => r.prerelease)
const stableVersion = latestStable?.version ?? '—'
---

<Base title="About" page="about">
  <section data-animate class="mx-auto max-w-3xl px-4 py-16">

    {/* App Info — 岛屿化 */}
    <AppInfoCard
      logoSrc="/logo.svg"
      logoAlt="Qomicex Launcher"
      name="Qomicex Launcher"
      versionLabel="Version"
      version={latestPre ? `${latestPre.version}${latestPre.prerelease ? ' (Preview)' : ''}` : latestStable?.version ?? '...' }
      description="A modern Minecraft launcher with multi-instance management, fast mod installation, account management, multiplayer support, and customizable themes. Fully open-source under GPL-3.0."
      repoUrl="https://github.com/Qomicex-Public/Qomicex.Tauri"
      repoLabel="View Repository"
    />

    {/* Overview — substantive content so the page is not thin */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">Overview</h2>
      <div class="space-y-3 text-sm leading-relaxed text-muted-foreground">
        <p>
          Qomicex Launcher (also known as QML Launcher) is a free, open-source launcher for Minecraft: Java Edition,
          built with Tauri and Rust. The goal is a launcher that starts quickly, uses few resources and offers a clean
          interface without sacrificing capability. The project is fully open source on GitHub under GPL-3.0, so anyone
          is free to use, review and redistribute it.
        </p>
        <p>
          Rather than only launching the game, QML brings the tasks you repeat every day into one place: creating and
          isolating multiple instances, searching and installing mods and modpacks from Modrinth and CurseForge,
          resolving prerequisite dependencies automatically, storing and switching accounts securely, and playing
          together over EasyTier mesh networking. It also covers auxiliary work such as editing game options and world
          settings, previewing worlds, and rendering <code class="font-mono text-xs bg-muted text-primary px-1.5 py-0.5 rounded">.litematic</code> schematics.
        </p>
        <p>
          In non-Chinese locales, signing in with a Microsoft account is required before third-party accounts can be
          added; this restriction exists to comply with platform licensing requirements. We recommend and prioritise
          signing in with a legitimate Microsoft account.
        </p>
      </div>
    </div>

    {/* Feature summary */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">What it does</h2>
      <ul class="ml-5 list-disc space-y-1.5 text-sm leading-relaxed text-muted-foreground">
        <li><strong class="text-foreground">Multi-instance management</strong>: per-instance Java, memory, window options and launch arguments, with version isolation, backup and restore.</li>
        <li><strong class="text-foreground">Game and loader installs</strong>: Minecraft from 1.6 through the latest release, plus Forge, Fabric, Quilt, NeoForge and OptiFine.</li>
        <li><strong class="text-foreground">Resource center</strong>: Modrinth and CurseForge integration with filtering by version, loader and category, dependency inspection, and direct install into a chosen instance.</li>
        <li><strong class="text-foreground">Account management</strong>: Microsoft, Yggdrasil (third-party login) and Unified Pass, with credentials encrypted locally and bound to the machine identifier.</li>
        <li><strong class="text-foreground">Multiplayer</strong>: EasyTier-based networking; join with a room code, no public IP or manual port forwarding required.</li>
        <li><strong class="text-foreground">Companion tools</strong>: graphical editing of game options and world settings, world map preview, and isometric schematic preview for <code class="font-mono text-xs bg-muted text-primary px-1.5 py-0.5 rounded">.litematic</code> blueprints.</li>
        <li><strong class="text-foreground">Updates</strong>: built-in update checks and installation, with separate stable and preview channels.</li>
      </ul>
    </div>

    {/* System requirements */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">System Requirements</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-border text-xs uppercase tracking-wider text-muted-foreground">
              <th class="py-2 pr-4 font-medium">Platform</th>
              <th class="py-2 pr-4 font-medium">Architecture</th>
              <th class="py-2 pr-4 font-medium">Min. Version</th>
              <th class="py-2 font-medium">Package</th>
            </tr>
          </thead>
          <tbody>
            {platforms.map(p => (
              <tr class="border-b border-border/50 last:border-0">
                <td class="py-2 pr-4 text-foreground">{p.os}</td>
                <td class="py-2 pr-4 text-muted-foreground">{p.arch}</td>
                <td class="py-2 pr-4 text-muted-foreground">{p.minVersion}</td>
                <td class="py-2 text-muted-foreground">{p.packageType}{p.note ? ` (${p.note})` : ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
        A working Java runtime is also required; the launcher can detect and install the Java version matching your
        target game version. Full details are on the
        <a href="/en/download" class="text-primary underline underline-offset-2">download page</a>.
      </p>
    </div>

    {/* Version Info — 原样保留 */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">Version Info</h2>
      <div class="rounded-lg bg-background p-4 text-sm">
        <div class="grid grid-cols-2 gap-3">
          {latestStable && <div><div class="text-xs text-muted-foreground">Stable</div><div class="mt-0.5 font-medium">{latestStable.version}</div></div>}
          {latestPre && <div><div class="text-xs text-muted-foreground">Preview</div><div class="mt-0.5 font-medium">{latestPre.version}</div></div>}
          {!latestStable && !latestPre && <div><div class="text-xs text-muted-foreground">App Version</div><div class="mt-0.5 font-medium">...</div></div>}
          <div><div class="text-xs text-muted-foreground">License</div><div class="mt-0.5 font-medium"><a href="https://www.gnu.org/licenses/gpl-3.0.en.html" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">GPL-3.0</a></div></div>
        </div>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-muted-foreground">
        The latest stable release is {stableVersion}. See the
        <a href="/en/versions" class="text-primary underline underline-offset-2">version history</a> for every release and
        the <a href="/en/changelog" class="text-primary underline underline-offset-2">changelog</a> for itemised changes.
      </p>
    </div>

    {/* Open source and contributing */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">Open Source &amp; Contributing</h2>
      <div class="space-y-3 text-sm leading-relaxed text-muted-foreground">
        <p>
          The project is open source under GPL-3.0. You are welcome to read the code, report problems and help improve
          it. Ways to contribute:
        </p>
        <ul class="ml-5 list-disc space-y-1.5">
          <li>Open an issue on GitHub to report a bug or suggest a feature; please attach the launcher log.</li>
          <li>Send a pull request for code or documentation improvements after reading the contribution notes in the repository.</li>
          <li>Before filing an issue, you may also find an answer in the <a href="/en/faq" class="text-primary underline underline-offset-2">FAQ</a> or the <a href="https://docs.qomicex.top" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">documentation</a>.</li>
        </ul>
        <p>
          This is an independent third-party tool with no affiliation, sponsorship or endorsement from Mojang Studios,
          Microsoft Corporation or their affiliates. Minecraft is a trademark of Mojang AB. If you do not own a
          legitimate copy of the game, please purchase one through official channels.
        </p>
      </div>
    </div>

    {/* Contributors — 岛屿化 */}
    <div class="mb-4 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">Developers</h2>
      {contributors.length === 0 && <p class="text-sm text-muted-foreground">No contributor information.</p>}
      <div class="space-y-3">
        {contributors.map(c => (
          <ContributorCard
            avatarUrl={c.avatar_url}
            login={c.login}
            contributions={c.contributions}
            htmlUrl={c.html_url}
          />
        ))}
      </div>
    </div>

    {/* Friends — complementary sites in the same ecosystem */}
    <FriendsCard
      title={t('about.friends', lang)}
      items={friends.map(f => ({ name: f.name, url: f.url, desc: f.desc[lang] }))}
    />

  </section>
</Base>

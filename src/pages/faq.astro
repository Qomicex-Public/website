---
import Base from '../layouts/Base.astro';
import { getFaqs } from '../data/faq.ts';
import { langFromPath } from '../i18n';
import FaqItem from '../components/faq/FaqItem';

const lang = langFromPath(Astro.url.pathname)
const faqs = getFaqs(lang)
---

<Base title="常见问题" page="faq">
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="mb-4 text-3xl font-bold">常见问题</h1>
    <p class="mb-8 text-sm leading-relaxed text-muted-foreground">
      以下整理 Qomicex Launcher（QML 启动器）使用过程中最常见的问题，涵盖版本与加载器支持、Java 环境、启动失败排查、实例迁移、模组与整合包安装、多人联机以及数据与隐私。若此处未能解决你的问题，请前往
      <a href="https://github.com/Qomicex-Public/Qomicex.Tauri/issues" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">GitHub Issues</a>
      提交，或在
      <a href="https://docs.qomicex.top" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">文档站</a>
      查阅详细的图文教程。
    </p>
    <div class="space-y-2">
      {faqs.map(faq => (
        <FaqItem question={faq.question} answer={faq.answer} />
      ))}
    </div>

    <div class="mt-12 rounded-xl border border-border bg-card p-6">
      <h2 class="mb-3 text-base font-semibold">仍未解决？</h2>
      <ul class="ml-5 list-disc space-y-1.5 text-sm leading-relaxed text-muted-foreground">
        <li>查看<a href="https://docs.qomicex.top" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">在线文档</a>中的安装与排障章节，含截图步骤说明。</li>
        <li>在<a href="https://github.com/Qomicex-Public/Qomicex.Tauri/issues" target="_blank" rel="noopener" class="text-primary underline underline-offset-2">GitHub Issues</a>搜索是否已有同类问题，或新建 Issue 并附上日志文件。</li>
        <li>加入 QQ 群 623362446 与其他用户交流（群号同样可在 GitHub 仓库页面获取）。</li>
      </ul>
    </div>
  </section>
</Base>

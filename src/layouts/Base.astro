---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { t, langFromPath } from '../i18n';

const lang = langFromPath(Astro.url.pathname)
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/'
const noindex: boolean = Astro.props.noindex ?? false
// 首页直接用规范标题（品牌 + 定位关键词）；内页为「页面名 | 品牌」，避免出现「QML启动器 — QML启动器」式的自我重复
const fullTitle: string = isHome
  ? t('site.homeTitle', lang)
  : (Astro.props.title ?? t('site.title', lang)) + t('site.titleSuffix', lang)
const desc = Astro.props.desc ?? t('site.description', lang)
const canonical = `https://www.qomicex.top${Astro.url.pathname.replace(/\/$/, '')}/`
const enUrl = lang === 'en' ? canonical : `https://www.qomicex.top/en${Astro.url.pathname}`
const zhUrl = lang === 'zh' ? canonical : `https://www.qomicex.top${Astro.url.pathname.replace(/^\/en/, '')}`
const ogImage = 'https://www.qomicex.top/og-image.webp'
---

<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="description" content={desc} />
    <meta name="keywords" content={t('site.keywords', lang)} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t('site.h1', lang)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Qomicex Launcher" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    {lang === 'zh' && <meta property="og:locale:alternate" content="en_US" />}
    <Analytics />
    <style is:global>
      .admonition {
        margin: 1.5em 0;
        padding: 1em 1.25em;
        border-left: 4px solid;
        border-radius: 0.5rem;
        font-size: 0.9rem;
        line-height: 1.6;
        color: hsl(var(--foreground));
      }
      .admonition > :first-child { margin-top: 0; }
      .admonition > :last-child { margin-bottom: 0; }
      .admonition.note    { background: hsl(220 70% 50% / 0.12); border-color: hsl(220 70% 50%); }
      .admonition.tip     { background: hsl(142 71% 48% / 0.12); border-color: hsl(142 71% 48%); }
      .admonition.warning { background: hsl(40 90% 50% / 0.12); border-color: hsl(40 90% 50%); }
      .admonition.danger,
      .admonition.caution { background: hsl(0 84% 60% / 0.12); border-color: hsl(0 84% 60%); }
    </style>
    <script>
      // 首访按系统语言导流到 /en/；但「用户显式选过语言」时必须尊重其选择，
      // 否则系统语言为英文的用户点顶栏「中」→ 进入 / → 又被弹回 /en/，
      // 永远无法停留在中文站（Header.astro 的切换锚点会写入 qml-lang）。
      ;(function () {
        var chosen = null
        try { chosen = localStorage.getItem('qml-lang') } catch (e) { chosen = null }

        if (chosen === 'zh') return  // 明确选中文：一律不自动跳转

        // 明确选英文：仅当当前处于中文路径时才导流，避免把 /en/xxx 也踢回 /en/ 首页
        if (chosen === 'en') {
          if (location.pathname === '/' || location.pathname === '') location.replace('/en/')
          return
        }

        // 未表达过偏好 → 沿用原有行为（仅首页按系统语言导流）
        if (location.pathname === '/' && navigator.language.startsWith('en')) {
          location.replace('/en/')
        }
      })()
    </script>
  </head>
  <body id="top" class="bg-background text-foreground">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />

    {/* 一键返回顶部：<a href="#top"> 原生锚点（html 已设 scroll-behavior:smooth），
        脚本仅按滚动位置切换可见性，不干预滚动本身；无 JS 时保持隐藏不占位。 */}
    <a
      id="to-top"
      href="#top"
      aria-label={lang === 'en' ? 'Back to top' : '返回顶部'}
      class="pointer-events-none fixed bottom-6 right-6 z-40 inline-flex size-10 items-center justify-center rounded-lg border border-border bg-background/90 text-muted-foreground opacity-0 shadow-sm backdrop-blur-sm transition-opacity duration-200 hover:text-foreground"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
        <path d="m18 15-6-6-6 6" />
      </svg>
    </a>
    <script>
      const toTop = document.getElementById('to-top')
      if (toTop) {
        const sync = () => {
          const show = window.scrollY > 400
          toTop.classList.toggle('opacity-0', !show)
          toTop.classList.toggle('pointer-events-none', !show)
        }
        sync()
        window.addEventListener('scroll', sync, { passive: true })
        document.addEventListener('astro:page-load', sync)
      }
    </script>
    <script>
      const observer = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add('animate-visible'); observer.unobserve(e.target) }
        }
      }, { threshold: 0.1 })
      function observeAnimate() {
        for (const el of document.querySelectorAll('[data-animate]')) observer.observe(el)
      }
      observeAnimate()
      document.addEventListener('astro:page-load', observeAnimate)
    </script>
    <script is:inline>
      console.log('%c' + [
        '  ██████╗   ██████╗  ███╗   ███╗ ██╗  ██████╗ ███████╗ ██╗    ██╗ ',
        ' ██╔═══██╗ ██╔═══██╗ ████╗ ████║ ██║ ██╔════╝ ██╔════╝  ╚██╗ ██╔╝ ',
        ' ██║   ██║ ██║   ██║ ██╔████╔██║ ██║ ██║      █████╗      ╚██╔╝   ',
        ' ██║ █╗██║ ██║   ██║ ██║╚██╔╝██║ ██║ ██║      ██╔══╝      █╔ █╗   ',
        ' ██║ ╚██╔╝ ██║   ██║ ██║ ╚═╝ ██║ ██║ ██║      ██║       ██╔╝  ██╗ ',
        ' ╚█████╔█╗ ╚██████╔╝ ██║     ██║ ██║ ╚██████╗ ███████╗ ██╔╝    ██╗',
        '  ╚════╝╚╝  ╚═════╝  ╚═╝     ╚═╝ ╚═╝  ╚═════╝  ╚═════╝ ╚═╝     ╚═╝ ',
        ' Console - Qomicex Launcher ======================================'
      ].join('\n'), 'color:#4fc3f7;font-family:monospace;')
    </script>
    <script is:inline>
      function initImageViewer() {
        var imgs = document.querySelectorAll('main img')
        if (!imgs.length) return
        var overlay = document.createElement('div')
        overlay.id = 'img-overlay'
        overlay.innerHTML = '<img alt="">'
        overlay.addEventListener('click', function(e) {
          if (e.target === overlay) hideImg()
        })
        document.body.appendChild(overlay)
        for (var i = 0; i < imgs.length; i++) {
          imgs[i].style.cursor = 'zoom-in'
          imgs[i].addEventListener('click', function() {
            showImg(this.getAttribute('src'))
          })
        }
      }
      function showImg(src) {
        var overlay = document.getElementById('img-overlay')
        if (!overlay) return
        overlay.querySelector('img').setAttribute('src', src)
        overlay.style.display = 'flex'
        document.body.style.overflow = 'hidden'
      }
      function hideImg() {
        var overlay = document.getElementById('img-overlay')
        if (!overlay) return
        overlay.style.display = 'none'
        document.body.style.overflow = ''
        overlay.querySelector('img').removeAttribute('src')
      }
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') hideImg()
      })
      function init() {
        initImageViewer()
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init)
      } else {
        init()
      }
      document.addEventListener('astro:page-load', init)
    </script>
  </body>
</html>

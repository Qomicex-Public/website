---
import { updatedAt } from '../data/last-fetch.json';
import stats from '../data/stats.json';
import { t, formatNumber, type Lang } from '../i18n';
import FooterUI from './Footer.tsx';

const lang = Astro.props.lang as Lang
const base = lang === 'en' ? '/en' : ''
const links = [
  { href: 'https://github.com/Qomicex-Public', label: 'GitHub', external: true },
  { href: 'https://qm.qq.com/q/rKiwzrkg8w', label: t('footer.qq', lang), external: true },
  { href: 'https://afdian.com/a/QomicexLauncher', label: t('footer.afdian', lang), external: true },
  { href: `${base}/about`, label: t('footer.about', lang) },
  { href: `${base}/legal/user-agreement`, label: t('footer.agreement', lang) },
]
---

<FooterUI
  copyright={t('footer.copyright', lang)}
  links={links}
  downloadsText={t('stats.downloads', lang, { n: formatNumber(stats.totalInstallerDownloads) })}
  usageText={t('stats.usage', lang, { n: formatNumber(stats.updateCheckCount) })}
  dataUpdatedText={t('footer.dataUpdated', lang)}
  dataUpdatedDate={updatedAt.slice(0, 10)}
/>
